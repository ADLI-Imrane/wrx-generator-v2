# ==================================================
# WRX Generator Web App - Environment Variables
# ==================================================

# Supabase (Public keys only!)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key
# Optional for local development with hosted Supabase when the browser cannot
# reach *.supabase.co directly: set VITE_SUPABASE_URL to
# http://127.0.0.1:5173/supabase and this to the hosted project URL.
# Never use the localhost URL in a production build.
# SUPABASE_PROXY_TARGET=https://your-project.supabase.co

# API
VITE_API_URL=http://localhost:3000

# Stripe (Public key only!)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# App
VITE_APP_URL=http://localhost:5173
VITE_SHORT_URL_DOMAIN=http://localhost:3000
VITE_SHORT_URL_BASE=http://localhost:3000/r

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Ads (Optional)
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_ID=
